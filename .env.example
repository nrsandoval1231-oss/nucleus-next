# Defaults: public GitHub discovery, loopback server, temporary server memory.
GITHUB_OWNER=nrsandoval1231-oss
PORT=4173
# Dedicated GitHub App installed only on selected repositories; PKCS#8 private key.
# Server-side only. Request grants are read-only; do not use a personal access token.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# Trusted authenticated owner ID, never an email or repository description.
# NUCLEUS_OWNER_ID=
# Node adapter only: enable solely behind an authenticating loopback reverse proxy.
# NUCLEUS_TRUST_PROXY=1
# Node adapter only. Apply packages/db/schema.sql before starting.
# DATABASE_URL=postgresql://...
